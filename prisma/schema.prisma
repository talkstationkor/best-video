// Best Video — Video Review & Approval System
// Reference schema for the shared bv_* tables in the tmt (tsai.kr) MariaDB.
//
// This app does NOT use Prisma at runtime: it reads and writes through the
// tmt Best Video API (/api/bv, Laravel), which owns the tables and the
// business rules. This file documents the table structure and produces the
// DDL for tmt migrations:
//
//   npm run schema:sql    (prints CREATE TABLE statements; no database access)
//
// To change a table, edit this file and add a matching Laravel migration in
// the tmt project. Never run prisma migrate or db push against the tmt
// database: Prisma would try to drop tmt's other tables.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Member {
  id        String   @id @default(cuid())
  name      String
  team      String
  role      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, team])

  projectsCreated   Project[]         @relation("ProjectCreatedBy")
  projectsAssigned  Project[]         @relation("ProjectAssignedEditor")
  versionsSubmitted ProjectVersion[]  @relation("VersionSubmittedBy")
  feedbackAuthored  Feedback[]        @relation("FeedbackAuthor")
  feedbackResolved  Feedback[]        @relation("FeedbackResolvedBy")
  approvals         ProjectVersion[]  @relation("VersionApprovedBy")
  activityLogs      ActivityLog[]     @relation("ActivityActor")
  notifications     Notification[]    @relation("NotificationRecipient")
  trainingUploads   TrainingSchoolUpload[] @relation("TrainingSchoolUploadedBy")

  @@map("bv_members")
}

model Project {
  id             String   @id @default(cuid())
  projectName    String
  details        String? @db.Text
  team           String
  status         String   @default("DRAFT")
  workflowStatus String   @default("EDITOR_WORKING")
  currentVersion Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   Member   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  assignedEditorId String?
  assignedEditor   Member? @relation("ProjectAssignedEditor", fields: [assignedEditorId], references: [id])

  finalVersionId String? @unique
  finalVersion   ProjectVersion? @relation("ProjectFinalVersion", fields: [finalVersionId], references: [id])

  approvedAt   DateTime?
  approvedById String?

  versions      ProjectVersion[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  trainingSchoolUploads TrainingSchoolUpload[]

  @@index([status])
  @@index([team])
  @@index([assignedEditorId])
  @@index([finalVersionId])

  @@map("bv_projects")
}

model ProjectVersion {
  id            String  @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id])

  versionNumber Int
  videoUrl      String @db.Text
  notes         String? @db.Text

  status      String   @default("REVIEW_REQUIRED")
  submittedAt DateTime @default(now())

  submittedById String
  submittedBy   Member @relation("VersionSubmittedBy", fields: [submittedById], references: [id])

  approvedAt   DateTime?
  approvedById String?
  approvedBy   Member? @relation("VersionApprovedBy", fields: [approvedById], references: [id])

  feedback     Feedback[]
  activityLogs ActivityLog[]

  finalForProject Project? @relation("ProjectFinalVersion")

  trainingSchoolUploads TrainingSchoolUpload[]

  @@unique([projectId, versionNumber])
  @@index([projectId])

  @@map("bv_project_versions")
}

model Feedback {
  id        String         @id @default(cuid())
  versionId String
  version   ProjectVersion @relation(fields: [versionId], references: [id])

  authorId String
  author   Member @relation("FeedbackAuthor", fields: [authorId], references: [id])

  message   String @db.Text
  timestamp String?
  status    String @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   Member? @relation("FeedbackResolvedBy", fields: [resolvedById], references: [id])

  @@index([versionId])

  @@map("bv_feedback")
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  recipientId String
  recipient   Member @relation("NotificationRecipient", fields: [recipientId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  versionId String?

  @@index([recipientId, isRead])

  @@map("bv_notifications")
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  detail    String? @db.Text
  team      String
  createdAt DateTime @default(now())

  actorId String
  actor   Member @relation("ActivityActor", fields: [actorId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  versionId String?
  version   ProjectVersion? @relation(fields: [versionId], references: [id])

  @@index([projectId])
  @@index([createdAt])

  @@map("bv_activity_logs")
}

model TrainingSchoolUpload {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  versionId String
  version   ProjectVersion @relation(fields: [versionId], references: [id])

  status String @default("UPLOAD_REQUIRED")

  trainingSchoolUrl String? @db.Text

  uploadedById String?
  uploadedBy   Member? @relation("TrainingSchoolUploadedBy", fields: [uploadedById], references: [id])

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, versionId])
  @@index([projectId])
  @@index([versionId])
  @@index([status])

  @@map("bv_training_school_uploads")
}